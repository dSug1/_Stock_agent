# Auto-detect text files and normalize line endings
* text=auto

# Force LF for scripts and source
*.py text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.md text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
