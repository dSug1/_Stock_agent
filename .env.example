USER_AGENT=
# Shared secrets for 1_not_used/ and 2_Funds_parser/.
# Copy this file to `.env` in the same (repo root) folder and fill in real values.
# `.env` itself is gitignored; only `.env.example` is committed.

# Anthropic — required only if 2_Funds_parser Module 6 (LLM scoring) runs.
ANTHROPIC_API_KEY=

# OpenFIGI — optional; used by Module 2 CUSIP resolver. Unauthenticated
# requests work but hit a lower rate limit.
OPENFIGI_API_KEY=
